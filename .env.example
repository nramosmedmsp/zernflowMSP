# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Late API key and AI Gateway key are set per-workspace in Settings UI.
# For self-hosted, you can optionally set AI_GATEWAY_API_KEY as a fallback.

# AI Gateway (for AI Response flow node, optional for self-hosted)
# On Vercel: configure provider keys in AI Gateway settings (automatic OIDC auth)
# Self-hosted: set this key from https://vercel.com/ai-gateway
# AI_GATEWAY_API_KEY=your-gateway-key

# Cron secret (for sequence processor + job scheduler)
CRON_SECRET=your-cron-secret

# App: dirección pública, sin barra final. Con ella se arman los enlaces de activación.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Correo saliente: se configura en la app (Configuración → Correo). Estas variables solo se
# usan como respaldo si esa configuración está vacía. Puerto 465 = SSL; otro = STARTTLS.
# SMTP_HOST=smtp.zeptomail.com
# SMTP_PORT=587
# SMTP_USER=emailapikey
# SMTP_PASS=tu-token-smtp
# MAIL_FROM=CRM Muscle Shop <no-responder@tudominio.com>

# Marca de la instalación (se ve en el login, el menú lateral y la pestaña del navegador).
# Cambia en cada despliegue (tienda y gimnasio) sin tocar código.
# NEXT_PUBLIC_APP_LOGO_URL puede ser una ruta de /public (p. ej. /logo.png) o una URL completa
# (https://...). Si se dejan vacías se usa "CRM", /logo.png y una descripción genérica.
# Al ser NEXT_PUBLIC_* se fijan al compilar: tras cambiarlas en Vercel hay que volver a desplegar.
NEXT_PUBLIC_APP_NAME=CRM Muscle Shop
NEXT_PUBLIC_APP_LOGO_URL=/logo.png
NEXT_PUBLIC_APP_DESCRIPTION=Gestión de conversaciones y clientes
